<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VoiSlate.ViewModels"
             xmlns:models="using:VoiSlate.Models"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="720"
             x:Class="VoiSlate.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <!--
    Agent C：设置页（对齐 settings_configue_page 意图；契约 §4 SettingsViewModel）。
    链接符/前缀经 ITakeFlowService 唯一写入口（C-2/BLOCKER-1）；清空/导出为占位命令
    （正式实现：DialogService 强确认 R12 + IExportService）。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28" Spacing="18" MaxWidth="720" HorizontalAlignment="Left">

      <TextBlock Text="VoiSlate 设置" FontSize="26" FontWeight="Bold" Foreground="#0067A0" />

      <!-- 工程名 -->
      <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="工程名" FontWeight="Bold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding ProjectName, Mode=TwoWay}" />
            <Button Grid.Column="1" Content="保存" Command="{Binding SaveProjectCommand}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- 记录设置：联动 / 链接符 / 前缀 -->
      <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel Spacing="12">
          <TextBlock Text="记录设置" FontWeight="Bold" />
          <CheckBox IsChecked="{Binding IsLinked, Mode=TwoWay}" Content="补录联动（解绑时进入补录模式，记条自动转 Wild——B3）" />
          <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Text="链接符（默认 -T，B6）" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding RecordLinker, Mode=TwoWay}" />
            <Button Grid.Column="2" Content="保存" Command="{Binding SaveLinkerCommand}" />
          </Grid>
          <StackPanel Spacing="6">
            <TextBlock Text="文件名前缀三模式（B6：默认日期 yymmdd / 声音设备 yyYmMd / 自定义）" FontSize="12" Foreground="#666666" />
            <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="前缀模式" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding PrefixModes}"
                        SelectedItem="{Binding PrefixMode, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />
              <Button Grid.Column="2" Content="保存" Command="{Binding SavePrefixCommand}" />
            </Grid>
            <TextBox Text="{Binding CustomPrefix, Mode=TwoWay}" PlaceholderText="自定义前缀文本（custom 模式生效）" IsEnabled="{Binding IsCustomPrefixEnabled}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 状态 -->
      <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="状态" FontWeight="Bold" />
          <TextBlock Text="{Binding TodayCount, StringFormat='今日场记条数：{0}'}" FontSize="13" Foreground="#444444" />
        </StackPanel>
      </Border>

      <!-- 数据操作（占位命令） -->
      <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel Spacing="8">
          <TextBlock Text="数据" FontWeight="Bold" />
          <Button Content="导出所有场记" HorizontalAlignment="Left" Foreground="#0067A0"
                  Command="{Binding ExportAllCommand}" />
          <TextBlock FontSize="11" Foreground="#888888"
                     Text="F1/F2：导出格式与原版一致（无日期字段；'导出全部'= 跨日合并导出，不可逆）" TextWrapping="Wrap" />
          <Button Content="清空今日场记" HorizontalAlignment="Left" Foreground="#C62828"
                  Command="{Binding ClearTodayCommand}" />
          <TextBlock FontSize="11" Foreground="#888888"
                     Text="占位：正式实现需 DialogService 强确认（契约 R12）+ 清空 API（E 演进；F3/F4 原行为保留）" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>