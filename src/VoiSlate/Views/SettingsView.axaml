<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VoiSlate.ViewModels"
             mc:Ignorable="d" d:DesignWidth="390" d:DesignHeight="820"
             x:Class="VoiSlate.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <!--
    复刻目标：voislate-html 之 .screen#screen-settings（docs/ui-layout-spec.md §7）。
    全屏页（进入时 MainWindow 隐藏全局 AppBar 与底部导航）；自带 .appbar.sub（#1D4F6E）
    返回头（MainViewModel.GoBackCommand）。
    注意：链接符/前缀模式/补录联动的编辑已归位记录页（FileCounter 编辑 + link-pill），
    本页不含重复项（对齐原版手机构成）。
    操作模式 / 音量键控制：HTML 有布局，契约 stub 不迁移 → 保留布局、禁用并注明；
    清空所有场记 / 清空拍摄计划：原版“重置+重启”演示，未迁移 → 禁用占位。
  -->
  <Grid RowDefinitions="40,*">
    <!-- appbar.sub -->
    <Border Grid.Row="0" Background="#1D4F6E" ZIndex="5">
      <Grid ColumnDefinitions="40,*,40">
        <Button x:Name="BackButton" Grid.Column="0" Width="40" Height="40" Background="Transparent" Foreground="White" Padding="0"
                HorizontalAlignment="Left" Click="OnBackClick"
                ToolTip.Tip="返回">
          <PathIcon Data="M20,11H7.83L13.42,5.41L12,4L4,12L12,20L13.42,18.59L7.83,13H20Z"
                    Width="20" Height="20" Foreground="White" />
        </Button>
        <TextBlock Grid.Column="1" Text="VoiSlate 设置" FontSize="17" FontWeight="Medium" Foreground="White"
                   VerticalAlignment="Center" HorizontalAlignment="Center" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="14,8,14,24">

        <!-- 工程名 -->
        <Grid ColumnDefinitions="*,Auto" MinHeight="56" Margin="0,10">
          <TextBlock Text="工程名" FontSize="15" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding ProjectName, Mode=TwoWay}" Width="200"
                   FontSize="15" TextAlignment="Right" VerticalContentAlignment="Center" Padding="0,6"
                   Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="#BBBBBB" />
        </Grid>

        <!-- 操作模式（布局复刻；契约 stub 不迁移 → 禁用） -->
        <Border BorderBrush="#ECECEC" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="*,Auto" MinHeight="56" Margin="0,10">
            <TextBlock Text="操作模式" FontSize="15" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Width="120" IsEnabled="False" SelectedIndex="0"
                      FontSize="15" VerticalContentAlignment="Center"
                      ToolTip.Tip="未迁移（原版 stub：左手/右手/中间）">
              <ComboBoxItem Content="左手" /><ComboBoxItem Content="右手" /><ComboBoxItem Content="中间" />
            </ComboBox>
          </Grid>
        </Border>

        <!-- 音量键控制（布局复刻；未迁移 → 禁用） -->
        <Border BorderBrush="#ECECEC" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="*,Auto" MinHeight="56" Margin="0,10">
            <TextBlock Text="音量键控制" FontSize="15" VerticalAlignment="Center"
                       ToolTip.Tip="未迁移（原版音量键采集 stub）" />
            <Border Grid.Column="1" Width="46" Height="26" CornerRadius="13" Background="#266489"
                    VerticalAlignment="Center" Opacity="0.6" IsEnabled="False">
              <Border Width="22" Height="22" CornerRadius="11" Background="White" Margin="22,2,2,2"
                      BoxShadow="0 1 3 0 #4D000000" />
            </Border>
          </Grid>
        </Border>

        <!-- 数据操作 -->
        <StackPanel Margin="0,10,0,0" Spacing="4">
          <Button Content="导出所有场记" FontSize="15" Padding="0,13" MinHeight="48" CornerRadius="6"
                  HorizontalContentAlignment="Center" Foreground="#1E88E5" Background="Transparent"
                  Command="{Binding ExportAllCommand}"
                  ToolTip.Tip="跨日合并导出 all.json（F2）" />
          <Border Height="1" Background="#ECECEC" />
          <Button Content="清空今日场记" FontSize="15" Padding="0,13" MinHeight="48" CornerRadius="6"
                  HorizontalContentAlignment="Center" Foreground="#F44336" Background="Transparent"
                  Command="{Binding ClearTodayCommand}"
                  ToolTip.Tip="仅清今日日志，不动文件号/picker_history（F3 已知行为保留）" />
          <Border Height="1" Background="#ECECEC" />
          <Button Content="清空所有场记" FontSize="15" Padding="0,13" MinHeight="48" CornerRadius="6"
                  HorizontalContentAlignment="Center" Foreground="#F44336" Background="Transparent"
                  IsEnabled="False" ToolTip.Tip="未迁移（原版需手动重启 App 演示）" />
          <Border Height="1" Background="#ECECEC" />
          <Button Content="清空所有拍摄计划" FontSize="15" Padding="0,13" MinHeight="48" CornerRadius="6"
                  HorizontalContentAlignment="Center" Foreground="#F44336" Background="Transparent"
                  IsEnabled="False" ToolTip.Tip="未迁移（计划页数据面接入后开放）" />
        </StackPanel>

        <!-- 今日计数（保留原 Avalonia 能力） -->
        <TextBlock Text="{Binding TodayCount, StringFormat='今日场记条数：{0}'}" FontSize="12"
                   Foreground="#888888" Margin="0,10,0,0" />

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>