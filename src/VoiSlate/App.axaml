<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiSlate.ViewModels"
             xmlns:views="using:VoiSlate.Views"
             x:Class="VoiSlate.App"
             RequestedThemeVariant="Default">

  <!--
    Agent C 接管（契约 v0.5：App.axaml / App.axaml.cs 所有权归 Agent C）。
    保留：本注释段、DI-REGISTRATION 区域（App.axaml.cs）、以及后续 VoiSlatePalette 合并（D）。
  -->

  <!--
    VM→View 隐式导航模板：DataTemplate 必须放在 DataTemplates 集合，不能放进 Resources
    （Resources 是键值集合，不接受无 x:Key 的隐式模板——之前 AVLN3000 的根因）。
  -->

  <Application.Styles>
    <FluentTheme />
    <!-- Agent D：自定义控件的默认样式/模板（StyleInclude 加载 selective Styles） -->
    <StyleInclude Source="avares://VoiSlate/Themes/Controls.axaml" />
  </Application.Styles>

  <Application.Resources>
    <!-- Agent D：主题色板资源键（VoiSlatePalette.axaml；键名契约 §6 逐字一致）。
         Avalonia 12 已移除 ResourceDictionary.Source——改用 ResourceInclude（编译期合并版 MergeResourceInclude）。 -->
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="avares://VoiSlate/Themes/VoiSlatePalette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vm:RecordViewModel}">
      <views:RecordView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ScheduleViewModel}">
      <views:ScheduleView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SlateLogViewModel}">
      <views:SlateLogView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
  </Application.DataTemplates>

  <!-- 主题资源键（VoiSlatePalette.axaml）将由 Agent D 产出并在此合并；C 视图暂用内联色值 -->

</Application>