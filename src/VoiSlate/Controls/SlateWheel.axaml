<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:VoiSlate.Controls"
             x:Class="VoiSlate.Controls.SlateWheel"
             x:DataType="controls:SlateWheel">

  <!--
    Agent C 占位 SlateWheel（契约 v0.5 §5 签名一致：Items/SelectedIndex(TwoWay)/ItemHeight/IsLoop +
    SelectedItemChanged + ScrollTo/ScrollNext/ScrollPrev；手势/滚轮/吸附/动画由 Agent D 的正式实现提供）。
    D 合入后删除本文件与 SlateWheel.axaml.cs。
  -->
  <UserControl.Styles>
    <Style Selector="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Styles>

  <ListBox x:Name="PART_List"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"
           BorderThickness="1"
           BorderBrush="#DDDDDD" />

</UserControl>