<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:VoiSlate.Controls"
             x:Class="VoiSlate.Controls.FileCounter"
             x:DataType="controls:FileCounter">

  <!--
    Agent C 占位 FileCounter（契约 v0.5 §5：Prefix/Linker/NumberText(TwoWay) + NumberValue(只读) +
    EditRequested(EditRequestedSection)；编辑对话框由视图层负责并经 ITakeFlowService 写文件号，BLOCKER-1）。
    D 合入后删除本文件与 FileCounter.axaml.cs。
  -->
  <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="8" Padding="12">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock x:Name="PrefixText" FontSize="24" FontWeight="Bold" />
          <TextBlock x:Name="LinkerText" FontSize="24" Foreground="#888888" />
          <TextBlock x:Name="NumberTextBlock" FontSize="24" FontWeight="Bold" Foreground="#0067A0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Content="前缀" Click="OnEditPrefixClick" />
          <Button Content="链接符" Click="OnEditLinkerClick" />
          <Button Content="编号" Click="OnEditNumberClick" />
        </StackPanel>
      </Grid>
      <TextBlock x:Name="NumberValueText" FontSize="12" Foreground="#888888" />
    </StackPanel>
  </Border>

</UserControl>